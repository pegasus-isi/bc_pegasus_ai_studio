#!/bin/env -S /bin/bash --noprofile --norc
. /etc/profile
set -exuo pipefail
trap 's=$?; echo "$0: Error on line "$LINENO": $BASH_COMMAND"; exit $s' ERR

#module purge
#module load apptainer/latest
#module list

echo "Starting PegasusAI Studio on $(hostname) port ${STUDIO_PORT}"
#echo "  dist:   ${STUDIO_DIST}"
echo "  prefix: ${STUDIO_URL_PREFIX:-<none>}"

PEGASUSAI_SERVER_IMAGE="<%= context.image_file %>"

<%- if context.debug=="1" -%>
printenv > environment
<%- end -%>

<%#- munge, slurm bind mounts are to enable slurm client commands like `srun` in Rstudio shell -%>
apptainer_bindpath_parts=(
    /run/slurm
    /etc/slurm
    /etc/passwd
    /etc/group
    /var/spool/slurm/slurmd/conf-cache/slurm.conf
    /etc/nsswitch.conf
    "$TMP:/tmp"
    "$PWD:/ood-session"
    "$HOME"
    "$APPTAINER_BINDPATH"
)
<%#- for some reason, adding $HOME to bind path fixes a mkdir error 17 "file exists" on ~/.cache/rstudio which only happens for certain users -%>
APPTAINER_BINDPATH="$(IFS=','; echo "${apptainer_bindpath_parts[*]}")"
export APPTAINER_BINDPATH

# Studio's entrypoint rejects '.' in STUDIO_URL_PREFIX, but the Unity portal
# only proxies /node/<FQDN>/<port>. Run a copy of it with '.' allowed (dots are
# safe everywhere the prefix is used). The grep fails the job loudly if a new
# image changes that line and the patch no longer applies.
studio_entrypoint="$PWD/studio-entrypoint.sh"
apptainer exec "$PEGASUSAI_SERVER_IMAGE" cat /usr/local/bin/entrypoint.sh \
    | sed '\|\*\[!A-Za-z0-9_/-\]\*)|s|0-9_/-|0-9_./-|' > "$studio_entrypoint"
grep -q 'A-Za-z0-9_\./-\]\*)' "$studio_entrypoint"
chmod +x "$studio_entrypoint"
APPTAINER_BINDPATH+=",$studio_entrypoint:/usr/local/bin/entrypoint.sh:ro"

# ---- Studio's own home (issue #1) ----
# Everything Studio writes is $HOME-relative: its database, ~/.pegasusrc, the
# generated CLAUDE.md/AGENTS.md, and the codex/opencode/claude configs its
# knowledge adapters write. With the real home as $HOME, a first launch
# overwrote the user's own setup of those tools. --home below gives Studio a
# directory of its own instead; studio-home.sh refuses the real home, anything
# containing it, and '.'/'..' tricks, and links credentials in from the real
# home so HTCondor submission and git identity keep working. The real home
# stays in APPTAINER_BINDPATH above, so terminals still reach existing data.
<%- require "shellwords" -%>
. "$(dirname "${BASH_SOURCE[0]}")/studio-home.sh"
REAL_HOME="$HOME"
STUDIO_HOME="$(studio_home_resolve <%= context.studio_home.to_s.strip.shellescape %> \
    "${STUDIO_HOME_DEFAULT:-$REAL_HOME/pegasus-studio}" "$REAL_HOME")"
studio_home_prepare "$STUDIO_HOME" "$REAL_HOME" \
    "${STUDIO_HOME_INHERIT-.condor/tokens.d .gitconfig}"
# Exported so the entrypoint sees it too: it re-asserts HOME from it if a
# launch ever drops --home.
export STUDIO_HOME
echo "  home:   ${STUDIO_HOME}"

# One session per Studio directory: studio.db is SQLite and the stack assumes
# it owns its state.
exec 9>"$STUDIO_HOME/.studio-session.lock"
if ! flock -n 9; then
    echo "A Pegasus AI Studio session is already using $STUDIO_HOME." >&2
    echo "Reconnect to it from 'My Interactive Sessions', or choose another" \
         "Studio directory." >&2
    exit 1
fi

apptainer run --home "$STUDIO_HOME" "$PEGASUSAI_SERVER_IMAGE"
