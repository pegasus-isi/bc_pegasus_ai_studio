#!/bin/env -S /bin/bash --noprofile --norc
. /etc/profile
set -exuo pipefail
trap 's=$?; echo "$0: Error on line "$LINENO": $BASH_COMMAND"; exit $s' ERR

module purge
module load apptainer/latest
module list

echo "Starting PegasusAI Studio on $(hostname) port ${STUDIO_PORT}"
#echo "  dist:   ${STUDIO_DIST}"
echo "  prefix: ${STUDIO_URL_PREFIX:-<none>}"

PEGASUSAI_SERVER_IMAGE="<%= context.image_file %>"

<%- if context.debug=="1" -%>
printenv > environment
<%- end -%>

<%#- munge, slurm bind mounts are to enable slurm client commands like `srun` in Rstudio shell -%>
apptainer_bindpath_parts=(
    /run/slurm
    /etc/slurm
    /etc/passwd
    /etc/group
    /var/spool/slurm/slurmd/conf-cache/slurm.conf
    /etc/nsswitch.conf
    "$TMP:/tmp"
    "$PWD:/ood-session"
    "$HOME"
    "$APPTAINER_BINDPATH"
)
<%#- for some reason, adding $HOME to bind path fixes a mkdir error 17 "file exists" on ~/.cache/rstudio which only happens for certain users -%>
APPTAINER_BINDPATH="$(IFS=','; echo "${apptainer_bindpath_parts[*]}")"
export APPTAINER_BINDPATH

# Studio's entrypoint rejects '.' in STUDIO_URL_PREFIX, but the Unity portal
# only proxies /node/<FQDN>/<port>. Run a copy of it with '.' allowed (dots are
# safe everywhere the prefix is used). The grep fails the job loudly if a new
# image changes that line and the patch no longer applies.
studio_entrypoint="$PWD/studio-entrypoint.sh"
apptainer exec "$PEGASUSAI_SERVER_IMAGE" cat /usr/local/bin/entrypoint.sh \
    | sed '\|\*\[!A-Za-z0-9_/-\]\*)|s|0-9_/-|0-9_./-|' > "$studio_entrypoint"
grep -q 'A-Za-z0-9_\./-\]\*)' "$studio_entrypoint"
chmod +x "$studio_entrypoint"
APPTAINER_BINDPATH+=",$studio_entrypoint:/usr/local/bin/entrypoint.sh:ro"

mkdir -p $HOME/.studio

apptainer run "$PEGASUSAI_SERVER_IMAGE"
