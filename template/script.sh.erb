#!/usr/bin/env bash

set -euo pipefail

set -a
<%- site_env = "/etc/ood/config/apps/pegasus-studio/site.env" -%>
<%- if File.exist?(site_env) -%>
<%= File.read(site_env) %>
<%- else -%>
# (no site.env found on the portal host at render time)
<%- end -%>
set +a

# Also source it at run time when present — a linux_host/linux_systemd session
# on the portal node itself can pick up edits without re-rendering.
if [ -f <%= site_env %> ]; then
    set -a
    # shellcheck disable=SC1091
    . <%= site_env %>
    set +a
fi

echo "Starting PegasusAI Studio on $(hostname) port ${STUDIO_PORT}"
echo "  dist:   ${STUDIO_DIST}"
echo "  prefix: ${STUDIO_URL_PREFIX:-<none>}"


# Set up singularity so that it can use Slurm

# Initialize an array to hold our bind paths
BIND_PATHS=()

# Helper function to append to the bind list if the path exists
add_bind() {
    if [ -e "$1" ]; then
        BIND_PATHS+=("$1")
    fi
}

# 1. Core Configs and Sockets
add_bind "/etc/slurm"
add_bind "/var/run/munge"

# 1.5 Allow container to resolve host users (SlurmUser, Munge, etc.)
add_bind "/etc/passwd"
add_bind "/etc/group"

# If your cluster uses SSSD/LDAP for user management, you need these too:
add_bind "/etc/nsswitch.conf"
add_bind "/var/lib/sss"

# 2. Find and add Slurm Binaries
for bin in sbatch srun squeue sinfo scontrol sacct; do
    bin_path=$(which $bin 2>/dev/null)
    if [ -n "$bin_path" ]; then
        add_bind "$bin_path"
    fi
done

# 3. Dynamically discover and add Libraries (libslurm, libmunge)
if SBATCH_BIN=$(which sbatch 2>/dev/null); then
    # Use ldd to find the directories containing slurm/munge libraries
    LIB_DIRS=$(ldd "$SBATCH_BIN" | awk '{print $3}' | grep -E 'libslurm|libmunge' | xargs -n1 dirname | sort -u)

    for dir in $LIB_DIRS; do
        # Use globs to catch the libraries AND their symlink targets
        # (e.g., catching .so.36 and .so.36.0.0 together)
        for lib in "$dir"/libslurm*.so* "$dir"/libmunge*.so*; do
            add_bind "$lib"
        done
    done
fi

# 4. Slurm Plugins Directory (loaded at runtime, not visible to ldd)
# Check common locations for the plugin libraries (like jobacct_gather)
if [ -d "/usr/lib64/slurm" ]; then
    add_bind "/usr/lib64/slurm"
elif [ -d "/usr/lib/slurm" ]; then
    add_bind "/usr/lib/slurm"
fi

# 5. Join the array with commas to create the bind string
BIND_STRING=$(IFS=,; echo "${BIND_PATHS[*]}")

# Export for both Singularity and Apptainer
export SINGULARITY_BIND="$BIND_STRING"
export APPTAINER_BIND="$BIND_STRING"

echo "SINGULARITY_BIND=$SINGULARITY_BIND"

# Download the container
mkdir -p $HOME/.studio
curl -o $HOME/.studio/webapp.sif https://download.pegasus.isi.edu/ondemand/6.0/studio-webapp-6.0.sif

singularity run $HOME/.studio/webapp.sif


