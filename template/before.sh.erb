# Batch-connect preamble — sourced by the job script before script.sh runs.

port=$(find_port)
export port

export STUDIO_PORT=${port}
export STUDIO_API_PORT=$(find_port)
export STUDIO_WEB_PORT=$(find_port)
export STUDIO_JUPYTER_PORT=$(find_port)
export STUDIO_OPENCODE_PORT=$(find_port)

# Studio refuses a token outside [A-Za-z0-9_-] at launch (it lands in a sed
# replacement, an nginx regex and a cookie). Normalize ONCE, here, and let the
# normalized value be $password itself: connection.yml then carries the exact
# string the gate expects, so view.html.erb can use it verbatim. Normalizing
# in both places instead would be two copies of one rule that must agree, and
# the failure mode when they drift is a Connect button that 403s.
password=$(create_passwd | tr -c 'A-Za-z0-9_-' '-')
export password

# This is what turns the whole gate on: proxy cookie check, loopback binds, a
# real Jupyter token, and the API's internal-secret requirement.
export STUDIO_AUTH_TOKEN="${password}"

# Front port for this session; the internal listeners are allocated by the
# launcher itself (STUDIO_ALLOC_PORTS), which is what keeps two users on one
# node from colliding.
export STUDIO_ALLOC_PORTS=1

# OOD proxies the session at /node/<host>/<port>/ — Studio renders its proxy
# locations for exactly that prefix and announces it via X-Forwarded-Prefix.
export STUDIO_URL_PREFIX="/node/$(hostname)/${port}"
